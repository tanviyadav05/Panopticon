# Laptop 05 only
PANOPTICON_ROLE=command
PORT=8000
PANOPTICON_RED_URL=http://red-laptop:8081
PANOPTICON_BLUE_URL=http://blue-laptop:8082
LLM_GATEWAY_URL=http://llm-laptop:8090
PANOPTICON_ARENA_URL=http://arena-laptop:30080
PANOPTICON_CONTROL_TOKEN=

# Always receive Observer telemetry when the dashboard is running. The live
# workload cycle itself remains disabled until explicitly armed.
PANOPTICON_LIVE_REFEREE_INGEST=1
PANOPTICON_LIVE_INGEST_PORT=9600
PANOPTICON_LIVE_CYCLE_ARMED=0
PANOPTICON_BLUE_LIVE_ARMED=0
PANOPTICON_DEMO=0
