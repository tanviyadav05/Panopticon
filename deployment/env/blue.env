# Laptop 03 only
PANOPTICON_ROLE=blue
PORT=8082
PANOPTICON_NAMESPACE=panopticon-arena
KUBECONFIG=$HOME/.kube/config
LLM_GATEWAY_URL=http://llm-laptop:8090
BLUE_CHECKPOINT_PATH=
BLUE_LIVE_ACTIONS_ARMED=0
BLUE_AUTONOMY_APPLY=0

# Optional bounded live resource-loop integration. Leave disabled for the
# standard demo; see deployment/LIVE_RESOURCE_LOOP.md before enabling it.
BLUE_LIVE_WORKLOAD_RELIEF_ARMED=0
PANOPTICON_LAB_TARGET_URL=http://arena-laptop:30080
PANOPTICON_LAB_CONTROL_TOKEN=
